# Decentralized Professional Credentials -- Environment Configuration
#
# Copy this file to .env and fill in the values.
# Both chains can be configured simultaneously.

# --- EVM Configuration ---

# Ethereum JSON-RPC endpoint.
# For local testing with the Ethereum Local Testing Starter Pack:
EVM_RPC_URL=http://host.docker.internal:41545

# Deployer's EVM account private key (hex, without 0x prefix).
# The starter pack's first pre-funded account:
EVM_DEPLOYER_PRIVATE_KEY=e2bffb8116e99d6fdf82f8c64a99826d51a5987b17fccf4093c6a514dbf90578

# Issuer's EVM account private key for registering/revoking credentials.
# Can be the same as the deployer, or a separate account:
EVM_ISSUER_PRIVATE_KEY=e2bffb8116e99d6fdf82f8c64a99826d51a5987b17fccf4093c6a514dbf90578

# Deployed EVM contract address (set by run_scenarios_evm.sh or manually after deploy)
EVM_CONTRACT_ADDRESS=

# --- IOTA Configuration ---

# Path to the IOTA Local Testing Starter Pack directory.
# Used by run_scenarios_iota.sh to access the iota-tools container for Move compilation.
IOTA_STARTER_PACK_DIR=

# IOTA full node JSON-RPC endpoint.
# For local testing with the IOTA Local Testing Starter Pack:
IOTA_RPC_URL=http://host.docker.internal:43900

# Deployer's IOTA account private key (iotaprivkey1... bech32 format).
# The starter pack's first pre-funded account:
IOTA_DEPLOYER_PRIVATE_KEY=iotaprivkey1qq8g3ngnmxywcf5y3spfr9n5qxun783g822suhh0zrq5uhgjzf2hjyfmp9j

# Issuer's IOTA account private key for registering/revoking credentials.
# Can be the same as the deployer, or a separate account:
IOTA_ISSUER_PRIVATE_KEY=iotaprivkey1qq8g3ngnmxywcf5y3spfr9n5qxun783g822suhh0zrq5uhgjzf2hjyfmp9j

# Deployed IOTA contract address in PACKAGE_ID:REGISTRY_ID format.
# Set by run_scenarios_iota.sh or manually after deploy.
IOTA_CONTRACT_ADDRESS=